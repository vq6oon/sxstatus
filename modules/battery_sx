#!/bin/bash

Accent="#7bb0b5"; Text="#f2e8b8"; Dim="#8fa8bf"
. ~/.cache/wal/sxstatus-colors 2>/dev/null
Text=$(xrdb -query 2>/dev/null | awk '$1=="dwm.normfgcolor:" {print $2; exit}')
[ -n "$Text" ] || Text="#c4cdce"

# battery module for sxstatus

Mid=70
Low=20

Bat=/sys/class/power_supply/BAT0
[ -d "$Bat" ] || exit 0

Capacity=$(cat "$Bat/capacity")
Status=$(cat "$Bat/status")

if [ "$Capacity" -le "$Low" ]; then
    Color="#c4696a"
elif [ "$Capacity" -le "$Mid" ]; then
    Color="#d6b36a"
else
    Color="$Accent"
fi

if   [ "$Capacity" -ge 90 ]; then Icon=$'\uf240'
elif [ "$Capacity" -ge 65 ]; then Icon=$'\uf241'
elif [ "$Capacity" -ge 40 ]; then Icon=$'\uf242'
elif [ "$Capacity" -ge 15 ]; then Icon=$'\uf243'
else Icon=$'\uf244'
fi

[ "$Status" = "Charging" ] && Icon=$'\uf0e7'

echo "^c$Text^$Icon^c$Text^ $Capacity%^d^"
