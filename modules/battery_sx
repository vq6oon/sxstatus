#!/bin/bash

# battery module for sxstatus

Mid=70
Low=20

Bat=/sys/class/power_supply/BAT0
[ -d "$Bat" ] || exit 0

Capacity=$(cat "$Bat/capacity")
Status=$(cat "$Bat/status")

if [ "$Capacity" -le "$Low" ]; then
    Color="#c4696a"
elif [ "$Capacity" -le "$Mid" ]; then
    Color="#d6b36a"
else
    Color="#7bb0b5"
fi

[ "$Status" = "Charging" ] && Plus="+"

echo "^c$Color^B $Capacity%$Plus^d^"