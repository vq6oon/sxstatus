#!/bin/bash

Accent="#7bb0b5"; Text="#f2e8b8"; Dim="#8fa8bf"
. ~/.cache/wal/sxstatus-colors 2>/dev/null

Icon="Mus:"

Song=$(mpc current)
Stat=$(mpc status | awk 'NR==2{print $1}' | sed 's/\[//g' | sed 's/\]//g')

if [ "$Stat" = "playing" ] ; then
        echo "$Icon $Song"
elif [ "$Stat" = "paused" ] ; then
        echo "Paused $Icon $Song"
else
        echo ""
fi
