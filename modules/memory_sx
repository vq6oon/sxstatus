#!/bin/bash

Accent="#7bb0b5"; Text="#f2e8b8"; Dim="#8fa8bf"
. ~/.cache/wal/sxstatus-colors 2>/dev/null

# memory module for sxstatus

Mid=60
High=85

Used=$(free -h | awk 'NR==2{print $3}' | sed 's/i//')
Percent=$(free | awk 'NR==2{printf "%d", $3/$2*100}')

if [ "$Percent" -ge "$High" ]; then
    Color="#c4696a"
elif [ "$Percent" -ge "$Mid" ]; then
    Color="#d6b36a"
else
    Color="$Accent"
fi

echo "^c$Color^$(printf '\uf085') $Used^d^"