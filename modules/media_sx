#!/bin/bash

# media module for sxstatus (any MPRIS player via playerctl, browsers ignored)

Ignore="firefox,chromium,chrome,brave,vivaldi,opera,edge"

State=$(playerctl -i "$Ignore" status 2>/dev/null)
Song=$(playerctl -i "$Ignore" metadata --format '{{ artist }} - {{ title }}' 2>/dev/null | tr -d '^')

case "$State" in
Playing) echo "^c#7bb0b5^$(printf '\uf001') $Song^d^" ;;
Paused)  echo "^c#d6b36a^$(printf '\uf001') $Song^d^" ;;
*)       echo "" ;;
esac