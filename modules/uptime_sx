#!/bin/bash

Accent="#7bb0b5"; Text="#f2e8b8"; Dim="#8fa8bf"
. ~/.cache/wal/sxstatus-colors 2>/dev/null
Text=$(xrdb -query 2>/dev/null | awk '$1=="dwm.normfgcolor:" {print $2; exit}')
[ -n "$Text" ] || Text="#c4cdce"

Icon="Up:"

Check=$(uptime -p | awk '{print $5}')
# under 24 hours
Uptime1=$(uptime -p | sed 's/up //')
# more than 24 hours
Uptime2=$(uptime -p | sed 's/up //' | cut -d ',' -f 1,2)

if [ "$Check" = "hours," ] ; then	#more than 1 day
	echo "^c$Text^ $Icon $Uptime2 ^d^"
elif [ "$Check" = "day," ] ; then	#more than 1 week
	echo "^c$Text^ $Icon $Uptime2 ^d^"
elif [ "$Check" = "week," ] ; then 	#more than 1 month
	echo "^c$Text^ $Icon $Uptime2 ^d^"
else
	echo "^c$Text^ $Icon $Uptime1 ^d^"
fi

