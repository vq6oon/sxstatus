#!/bin/bash

export PATH="${PATH}:$HOME/.config/sxstatus/modules"
export LANG=C.UTF-8

Sep=" | "

Seg() {
    local b
    [ -n "$2" ] || return 0
    printf -v b "\\$(printf '%03o' "$1")"
    printf '%s%s%s' "$b" "$2" "$b"
}

add() { [ -n "$1" ] && Out="${Out:+$Out$Sep}$1"; }

Plain() { sed -E 's/\^[a-z][^^]*\^//g'; }

while true; do
    Out=""
    add "$(Seg 1 "$(media_sx)")"
    add "$(Seg 2 "$(memory_sx)")"
    add "$(Seg 3 "$(battery_sx)")"
    add "$(Seg 4 "$(volume_sx)")"
    add "$(Seg 5 "$(wifi_sx)")"
    add "$(Seg 6 "$(bt_sx)")"
    add "$(Seg 7 "$(cal_sx)")"
    add "$(Seg 8 "$(clock_sx)")"
    
    xsetroot -name "$(printf '%s' "$Out" | Plain)"
    sleep 2
done
